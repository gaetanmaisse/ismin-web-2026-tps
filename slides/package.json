{
  "name": "ismin-web-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev s01-git-typescript.md --open",
    "dev:s01": "slidev s01-git-typescript.md --open",
    "dev:s02": "slidev s02-nestjs.md --open",
    "dev:s03": "slidev s03-persistance.md --open",
    "dev:s04": "slidev s04-authentification.md --open",
    "build": "npm run build:s01 && npm run build:s02 && npm run build:s03 && npm run build:s04 && npm run build:s06 && npm run build:s07 && npm run build:s08 && npm run build:s10 && npm run build:s12 && npm run build:projet",
    "build:s01": "slidev build s01-git-typescript.md --base /ismin-web-2026-tps/s01/ --out dist/s01",
    "build:s02": "slidev build s02-nestjs.md --base /ismin-web-2026-tps/s02/ --out dist/s02",
    "build:s03": "slidev build s03-persistance.md --base /ismin-web-2026-tps/s03/ --out dist/s03",
    "build:s04": "slidev build s04-authentification.md --base /ismin-web-2026-tps/s04/ --out dist/s04",
    "export:s01": "slidev export s01-git-typescript.md --output export/s01.pdf",
    "export:s02": "slidev export s02-nestjs.md --output export/s02.pdf",
    "export:s03": "slidev export s03-persistance.md --output export/s03.pdf",
    "export:s04": "slidev export s04-authentification.md --output export/s04.pdf",
    "check:s01": "slidev export s01-git-typescript.md --format png --output ../.preview/s01 --timeout 90000",
    "check:s02": "slidev export s02-nestjs.md --format png --output ../.preview/s02 --timeout 90000",
    "check:s03": "slidev export s03-persistance.md --format png --output ../.preview/s03 --timeout 90000",
    "check:s04": "slidev export s04-authentification.md --format png --output ../.preview/s04 --timeout 90000",
    "dev:s06": "slidev s06-audit.md --open",
    "build:s06": "slidev build s06-audit.md --base /ismin-web-2026-tps/s06/ --out dist/s06",
    "export:s06": "slidev export s06-audit.md --output export/s06.pdf",
    "check:s06": "slidev export s06-audit.md --format png --output ../.preview/s06 --timeout 90000",
    "dev:s07": "slidev s07-react.md --open",
    "build:s07": "slidev build s07-react.md --base /ismin-web-2026-tps/s07/ --out dist/s07",
    "export:s07": "slidev export s07-react.md --output export/s07.pdf",
    "check:s07": "slidev export s07-react.md --format png --output ../.preview/s07 --timeout 90000",
    "dev:s08": "slidev s08-routage.md --open",
    "build:s08": "slidev build s08-routage.md --base /ismin-web-2026-tps/s08/ --out dist/s08",
    "export:s08": "slidev export s08-routage.md --output export/s08.pdf",
    "check:s08": "slidev export s08-routage.md --format png --output ../.preview/s08 --timeout 90000",
    "dev:s10": "slidev s10-routage-connexion.md --open",
    "build:s10": "slidev build s10-routage-connexion.md --base /ismin-web-2026-tps/s10/ --out dist/s10",
    "export:s10": "slidev export s10-routage-connexion.md --output export/s10.pdf",
    "check:s10": "slidev export s10-routage-connexion.md --format png --output ../.preview/s10 --timeout 90000",
    "dev:s12": "slidev s12-docker.md --open",
    "build:s12": "slidev build s12-docker.md --base /ismin-web-2026-tps/s12/ --out dist/s12",
    "export:s12": "slidev export s12-docker.md --output export/s12.pdf",
    "check:s12": "slidev export s12-docker.md --format png --output ../.preview/s12 --timeout 90000",
    "dev:projet": "slidev projet.md --open",
    "build:projet": "slidev build projet.md --base /ismin-web-2026-tps/projet/ --out dist/projet",
    "export:projet": "slidev export projet.md --output export/projet.pdf",
    "check:projet": "slidev export projet.md --format png --output ../.preview/projet --timeout 90000"
  },
  "dependencies": {
    "@slidev/cli": "^52.0.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.63.0"
  }
}
