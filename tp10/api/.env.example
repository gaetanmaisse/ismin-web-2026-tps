# No quotes around the values: `docker run --env-file` (step 2) would keep them.
# The SQLite file. In compose, it lives in a volume: file:/app/db/modelzoo.db
DATABASE_URL=file:./dev.db
JWT_SECRET=dev-secret-change-me-in-production
JWT_REFRESH_SECRET=
PORT=3000
LOG_LEVEL=debug
RATE_LIMIT_LOGIN=5
# Where the frontend runs: the only origin allowed to call this API from a browser
WEB_ORIGIN=http://localhost:5173
