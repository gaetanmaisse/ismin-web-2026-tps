{
  "name": "tp10-modelzoo-api",
  "version": "1.0.0",
  "private": true,
  "description": "TP10: the ModelZoo API, ready for Docker. Web Development, ISMIN 3A.",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'TODO: eslint'",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio --url file://./dev.db",
    "db:seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "prisma": "^7.10.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
